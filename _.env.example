# Server-side secrets for the "api" Edge Function. NEVER commit a real .env. Placeholders only.
# Set them with:  supabase secrets set --env-file supabase/.env      (or in the Supabase dashboard: Edge Functions > Secrets)

# Required
QWEN_API_KEY=YOUR_MODEL_STUDIO_API_KEY
# Pick the region that matches the account the key was created in (keys are region-specific):
#   Singapore  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   US         https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   China      https://dashscope.aliyuncs.com/compatible-mode/v1
#   Workspace-style endpoints put the workspace in the host; use the {WorkspaceId} template and set QWEN_WORKSPACE_ID below:
#   https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Optional
# QWEN_WORKSPACE_ID=YOUR_WORKSPACE_ID      (only if QWEN_BASE_URL contains {WorkspaceId})
# QWEN_TEMPERATURE=0.3                     (0 to 1.5)
# QWEN_MAX_TOKENS=800                      (1 to 4096)
# QWEN_TIMEOUT_MS=30000                    (1000 to 60000)
# QWEN_ALLOW_ANY_HOST=false                (leave false unless you front Qwen with your own https gateway)
# ALLOWED_ORIGIN=https://YOUR-NAME.github.io
